{
  "version": "0.1.0",
  "questionnaire_catalog": {
    "source": "question_bank",
    "questionBank": "../questionBank",
    "categories": [
      "surveys",
      "tripSurveys",
      "locationReports"
    ]
  },
  "questionnaires": {
    "consent": {
      "privacy_link": "https://smarturbanity.github.io/smarturbanity-configuration/privacy-smarturbanity.html",
      "transparency_link": "https://smarturbanity.github.io/smarturbanity-configuration/privacy-smarturbanity.html"
    }
  },
  "configuration_sources": {
    "defaults": {
      "url": "../base.json"
    },
    "pilot": {
      "url": "../pilots/{pilot}/{pilot}.json"
    },
    "merge": "deep"
  },
  "content": {
    "datasets": [
      {
        "url": "../pilots/{pilot}"
      }
    ]
  },
  "questionnaire_review": {
    "collection": {
      "url": "../questionBank/feed.json"
    },
    "reference": {
      "url": "../questionBank/review/reference.json"
    },
    "provenance": {
      "url": "../questionBank/review/source.json"
    }
  }
}
