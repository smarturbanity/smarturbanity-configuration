          "scale": [
            "not_safe",
            "slightly_safe",
            "moderately_safe",
            "very_safe",
            "completely_safe"
          ],
          "rating_direction": "higher_is_better"
        },
        {
          "id": "pleasantness",
          "label": "#Pleasantness",
          "bi_class": "bi-emoji-smile",
          "questionnaire_id": "smarturbanity_geolocated_perception_report",
          "questionnaire_versions": [
            "0.2.2"
          ],
          "answer_key": "place_pleasantness",
          "scale": [
            "very_unpleasant",
            "unpleasant",
            "neutral",
            "pleasant",
            "very_pleasant"
          ],
          "rating_direction": "higher_is_better"
        },
        {
          "id": "overall_impression",
          "label": "#Overall impression",
          "bi_class": "bi-eye",
          "questionnaire_id": "smarturbanity_geolocated_perception_report",
          "questionnaire_versions": [
            "0.2.2"
          ],
          "answer_key": "place_overall",
          "scale": [
            "very_negative",
            "negative",
            "neutral",
            "positive",
            "very_positive"
          ],
          "rating_direction": "higher_is_better"
        }
