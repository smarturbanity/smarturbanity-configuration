{
  "questionnaire": {
    "name": "Service Correction Report",
    "questionnaire_id": "smarturbanity_service_correction_report",
    "questionnaire_version": "1.1.0",
    "project": "SmartUrbanity",
    "image": "https://raw.githubusercontent.com/smarturbanity/smarturbanity-configuration/main/forms/locationReports/assets/smarturbanity_missing_network_element_report.svg",
    "image_alt": "#Street with a missing section and a plus sign",
    "estimated_minutes": 1,
    "options": {
      "review_mode": true,
      "save_user_id": true,
      "ask_consent": true,
      "ask_adult": true
    },
    "sections": [
      {
        "title": "Fix this service",
        "description": "Tell us what is wrong so we can correct the map.",
        "questions": [
          {
            "text": "What is wrong with this service?",
            "answer_key": "correction_reason",
            "question_type": "single_option",
            "add_other": true,
            "other_input": {
              "text": "Tell us what is wrong",
              "answer_key": "correction_reason_other",
              "type": "text",
              "required": true
            },
            "checks_inline": false,
            "required": true,
            "options": [
              {
                "text": "It no longer exists",
                "value": "no_longer_exists"
              },
              {
                "text": "It is in the wrong place",
                "value": "wrong_location"
              },
              {
                "text": "It is a duplicate of another service",
                "value": "duplicate_entry"
              },
              {
                "text": "Its information is wrong (name, type, hours...)",
                "value": "wrong_information"
              }
            ]
          }
        ]
      },
      {
        "title": "A few quick details",
        "description": "These answers help us fix the right thing.",
        "questions": [
          {
            "text": "When did it close?",
            "answer_key": "closed_when",
            "question_type": "single_option",
            "show_if": {
              "correction_reason": [
                "no_longer_exists"
              ]
            },
            "checks_inline": false,
            "required": true,
            "options": [
              {
                "text": "Less than a month ago",
                "value": "lt_month"
              },
              {
                "text": "This year",
                "value": "this_year"
              },
              {
                "text": "More than a year ago",
                "value": "gt_year"
              },
              {
                "text": "I don't know",
                "value": "unknown"
              }
            ]
          },
          {
            "text": "How do you know?",
            "answer_key": "closed_source",
            "question_type": "single_option",
            "show_if": {
              "correction_reason": [
                "no_longer_exists"
              ]
            },
            "checks_inline": false,
            "required": true,
            "options": [
              {
                "text": "I saw it on site",
                "value": "on_site"
              },
              {
                "text": "Local knowledge",
                "value": "local_knowledge"
              },
              {
                "text": "Official source or website",
                "value": "official_source"
              },
              {
                "text": "Other",
                "value": "other"
              }
            ]
          },
          {
            "text": "Is something else there now?",
            "answer_key": "replaced_by",
            "question_type": "text",
            "show_if": {
              "correction_reason": [
                "no_longer_exists"
              ]
            },
            "required": false
          },
          {
            "text": "Where is it really?",
            "answer_key": "real_location",
            "question_type": "text",
            "show_if": {
              "correction_reason": [
                "wrong_location"
              ]
            },
            "required": true,
            "placeholder": "Address or a short description"
          },
          {
            "text": "How far is it from the marked place?",
            "answer_key": "location_distance",
            "question_type": "single_option",
            "show_if": {
              "correction_reason": [
                "wrong_location"
              ]
            },
            "checks_inline": false,
            "required": true,
            "options": [
              {
                "text": "About the same street",
                "value": "same_street"
              },
              {
                "text": "Within 200 m",
                "value": "within_200m"
              },
              {
                "text": "Farther",
                "value": "farther"
              },
              {
                "text": "I don't know",
                "value": "unknown"
              }
            ]
          },
          {
            "text": "Which service is it a duplicate of?",
            "answer_key": "duplicate_of",
            "question_type": "text",
            "show_if": {
              "correction_reason": [
                "duplicate_entry"
              ]
            },
            "required": true,
            "placeholder": "Name or address"
          },
          {
            "text": "Which entry is the right one?",
            "answer_key": "duplicate_keep",
            "question_type": "single_option",
            "show_if": {
              "correction_reason": [
                "duplicate_entry"
              ]
            },
            "checks_inline": false,
            "required": true,
            "options": [
              {
                "text": "This one",
                "value": "this_one"
              },
              {
                "text": "The other one",
                "value": "other_one"
              },
              {
                "text": "Not sure",
                "value": "not_sure"
              }
            ]
          },
          {
            "text": "Which information is wrong?",
            "answer_key": "wrong_fields",
            "question_type": "multiple_options",
            "show_if": {
              "correction_reason": [
                "wrong_information"
              ]
            },
            "checks_inline": false,
            "required": true,
            "options": [
              {
                "text": "Name",
                "value": "name"
              },
              {
                "text": "Type of service",
                "value": "service_type"
              },
              {
                "text": "Opening hours",
                "value": "opening_hours"
              },
              {
                "text": "Contact",
                "value": "contact"
              },
              {
                "text": "Accessibility",
                "value": "accessibility"
              },
              {
                "text": "Other",
                "value": "other"
              }
            ]
          },
          {
            "text": "What is the correct information?",
            "answer_key": "correct_information",
            "question_type": "textarea",
            "show_if": {
              "correction_reason": [
                "wrong_information"
              ]
            },
            "required": true
          },
          {
            "text": "Anything else we should know?",
            "answer_key": "correction_details",
            "question_type": "text",
            "required": false
          }
        ]
      }
    ],
    "gdpr_link": "https://planeasy-webgis.github.io/planeasy-crowdsourcing-framework/docs/PRIVACY_GUIDELINES.html"
  },
