      "source_collections": [
        "nodes"
      ],
      "source_selectors": [
        {
          "property": "osm.highway",
          "values": [
            "crossing"
          ]
        }
      ],
      "exclude_selectors": [
        {
          "property": "osm.crossing",
          "values": [
            "no"
          ]
        }
      ],
      "type": "crossing",
      "id_prefix": "osm-node:",
      "mode_access": {
        "walk": {
          "default": true,
          "property": "osm.foot"
        },
        "bike": {
          "property": "osm.bicycle"
        }
      }
    },
    "package_properties": {
      "segments": {
        "omit_null": true,
        "properties": [
          "name",
          "sped",
          "segment_type",
          "access",
          "infrastructure",
