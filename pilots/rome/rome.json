{
  "version": "0.1.0",
  "pilot_id": "rome",

  "mode_selection": ["walk", "bike", "transit"],
  "default_mode": "walk",
  "questionnaires": {"consent": {"adult": {"enabled": true, "min_age": 18}}},
  "data_model": {
    "runtime": {"source": "server"},
    "study_area": {
      "name": "Municipio XII",
      "area_group_id": "study_areas",
      "minimum_area_overlap_ratio": 0.5,
      "selector": {"property": "municipio", "values": ["XII"]},
      "membership": {"area_group_id": "neighbourhoods", "name_property": "denominazi"}
    },
    "data_bbox_buffer_meters": 1000,
    "data_bbox": [12.22488438786681, 41.82752843573868, 12.487301122135545, 41.917419029041276],
    "connections": {
      "source_collections": ["nodes"],
      "source_selectors": [{"property": "osm.highway", "values": ["crossing"]}],
      "exclude_selectors": [{"property": "osm.crossing", "values": ["no"]}],
      "type": "crossing",
      "id_prefix": "osm-node:",
      "mode_access": {
        "walk": {"default": true, "property": "osm.foot"},
        "bike": {"property": "osm.bicycle"}
      }
    },
    "package_properties": {
      "segments": {"omit_null": true, "properties": ["name", "sped", "segment_type", "access", "infrastructure", "access_rules.walk.allowed", "access_rules.walk.forward.allowed", "access_rules.walk.backward.allowed", "access_rules.bike.allowed", "access_rules.bike.forward.allowed", "access_rules.bike.backward.allowed", "access_rules.car.allowed", "access_rules.car.forward.allowed", "access_rules.car.backward.allowed", "physical_infrastructure.layer", "physical_infrastructure.level", "physical_infrastructure.bridge", "physical_infrastructure.tunnel", "physical_infrastructure.barrier", "physical_infrastructure.width_m", "osm.id", "osm.segment", "osm.direction", "osm.oneway", "osm.oneway:foot", "osm.oneway:bicycle", "osm.cycleway", "osm.cycleway:left", "osm.cycleway:right", "osm.cycleway:both", "osm.foot:forward", "osm.foot:backward", "osm.bicycle:forward", "osm.bicycle:backward", "osm.junction", "osm.crossing", "osm.tunnel", "osm.bridge", "osm.layer", "osm.level", "osm.barrier", "osm.node_controls", "osm.alt_name"]},
      "areas": {"omit_null": true, "properties": ["source_area_id", "source_layer_id", "inside_study_area", "name", "denominazi", "tipo", "municipio", "classe_fun", "habitants_total", "habitants_students", "habitants_workers", "habitants_retired", "buildings_total", "buildings_residential", "buildings_commercial"]},
      "nodes": {"properties": []},
      "connections": {"properties": ["walk_access", "bike_access"]}
    },
    "default_area_group_id": "neighbourhoods",
    "area_groups": {
      "neighbourhoods": {"name": "Quartieri", "order": 10, "view": "access_inspector", "icon": "bi-map", "source_layers": ["su_areas"]},
      "study_areas": {"name": "Municipio XII", "order": 20, "view": "access_inspector", "icon": "bi-bounding-box", "selectable": false, "source_layers": ["su_study_areas"]},
      "census": {"name": "Sezioni censuarie", "order": 30, "view": "access_inspector", "icon": "bi-grid-3x3-gap", "source": "server", "source_layers": ["cells"]},
      "h3": {"name": "Celle H3", "order": 40, "view": "access_inspector", "icon": "bi-hexagon", "source": "server", "resolution": 9, "source_layers": ["su_hexagons"]}
    }
  }
}
